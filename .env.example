# Client-side (Vite — injected at build time, safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side only (never sent to the browser)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runtime — Railway sets PORT automatically; do NOT add it as a Railway variable
PORT=
NODE_ENV=production
